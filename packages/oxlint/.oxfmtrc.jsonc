{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Configuration managed by @rewardstyle/oxfmt-config
  "printWidth": 120,
  "arrowParens": "always",
  "trailingComma": "all",
  "embeddedLanguageFormatting": "auto",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "singleAttributePerLine": false,
  "insertFinalNewline": true,
  "jsxSingleQuote": false,
  "objectWrap": "preserve",
  "experimentalSortPackageJson": true,
  "experimentalSortImports": {
    "newlinesBetween": true,
    "partitionByNewline": false,
    "ignoreCase": false,
    "internalPattern": ["#", "@@/", "~~/", "@/", "~/"],
    "groups": [
      ["type-import"],
      ["builtin"],
      ["external"],
      ["internal"],
      ["parent", "sibling", "index"],
      ["ts-equals-import"],
      ["side-effect"],
      ["style", "side-effect-style"],
      ["unknown"],
    ],
  },
  "ignorePatterns": ["node_modules", ".build-utils", "build", "dist", ".react-router"],
}
