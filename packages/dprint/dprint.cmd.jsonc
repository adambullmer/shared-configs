{
  "prettier": {
    "overrides": [
      {
        "files": [
          "**/.vscode/extensions.json",
          "**/.vscode/launch.json",
          "**/.vscode/settings.json",
          "**/tsconfig*.json",
          "**/jsconfig*.json",
          "**/dprint.json",
          "**/dprint.*.json",
        ],
        "options": {
          "parser": "json5",
          "quoteProps": "preserve",
          "singleQuote": false,
          "trailingComma": "all",
        },
      },
    ],
  },

  // Non-native Configs
  "exec": {
    "commands": [
      {
        "command": "gofmt",
        "exts": ["go"],
      },
      {
        "command": "php-cs-fixer fix --rules=@PSR12 {{file_path}}",
        "exts": ["php"],
      },
      {
        "command": "shfmt --apply-ignore -i 4 -bn",
        "exts": ["sh"],
      },
      {
        "command": "sqlfmt --print-width 60 --tab-width {{indent_width}} --align --casemode upper",
        "exts": ["sql"],
      },
    ],
  },
}
